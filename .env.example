# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fyalign?schema=public"

# JWT Authentication
JWT_SECRET="fyalign-super-secure-production-jwt-secret-key-32chars-min"
JWT_REFRESH_SECRET="fyalign-super-secure-refresh-jwt-secret-key-32chars-min"

# S3 / Cloud Storage
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="mock-aws-secret-access-key"
AWS_S3_BUCKET_NAME="fyalign-cases-vault"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Transactional Email (Convites da Equipe & Segurança)
# Opção A — SMTP (Gmail Senha de App, Office365, Hostinger, Amazon SES, etc.)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="FyAlign Plataforma <amadeu.turolla07@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="amadeu.turolla07@gmail.com"
SMTP_PASS=""

# Opção B — Resend API (alternativa direta via HTTP sem SMTP)
RESEND_API_KEY=""
